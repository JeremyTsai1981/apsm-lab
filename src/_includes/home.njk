---
layout: base.njk
---
<section class="hero" id="top">
  <div class="hero__sim">
    <canvas id="blast" role="img" aria-label="{{ i18n.hero.sim.aria | l(lang) }}"></canvas>
    <div class="hud" aria-hidden="true">
      <span class="hud__tag"><span class="hud__dot"></span>{{ i18n.hero.sim.tag | l(lang) }}</span>
      <span class="hud__row"><span>{{ i18n.hero.sim.t | l(lang) }}</span><b><span id="hud-t">0.0</span> ms</b></span>
      <span class="hud__row"><span>{{ i18n.hero.sim.ps | l(lang) }}</span><b><span id="hud-ps">—</span> kPa</b></span>
      <span class="hud__row"><span>{{ i18n.hero.sim.pr | l(lang) }}</span><b><span id="hud-p">0</span> kPa</b></span>
      <span class="legend"><span class="legend__bar"></span><span class="legend__ticks"><span>10</span><span>100</span><span>1000</span></span><span class="legend__lbl">{{ i18n.hero.sim.legend | l(lang) }}</span></span>
    </div>
  </div>
  <div class="wrap hero__in">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--cyan">{{ i18n.hero.eyebrow | l(lang) }}</p>
      <h1>{{ i18n.hero.title | l(lang) | safe }}</h1>
      <p class="hero__lead">{{ i18n.hero.lead | l(lang) }}</p>
      <div class="btns">
        <a class="btn btn--orange" href="#join">{{ i18n.hero.ctaJoin | l(lang) }}</a>
        <a class="btn btn--cyan-outline" href="#industry">{{ i18n.hero.ctaIndustry | l(lang) }}</a>
      </div>
    </div>
  </div>
  <p class="wrap hero__note">{{ i18n.hero.sim.note | l(lang) }}</p>
</section>

<section class="partners" aria-label="{{ i18n.partners.label | l(lang) }}">
  <div class="wrap partners__in">
    <span class="partners__lbl">{{ i18n.partners.label | l(lang) }}</span>
    <ul class="partners__list">{% for p in partners %}<li>{{ p | l(lang) }}</li>{% endfor %}</ul>
  </div>
</section>

<section class="stats" aria-label="{{ 'Lab in numbers' if lang == 'en' else '實驗室數字' }}">
  <div class="wrap stats__grid">
    {% for s in stats %}
    <div class="stat"><span class="stat__v">{{ s.value }}</span><span class="stat__l">{{ s.label | l(lang) }}</span></div>
    {% endfor %}
  </div>
</section>

<section class="section section--dark" aria-labelledby="hl-h">
  <div class="wrap">
    <p class="eyebrow eyebrow--cyan">{{ i18n.highlights.eyebrow | l(lang) }}</p>
    <h2 id="hl-h">{{ i18n.highlights.title | l(lang) }}</h2>
    <div class="gallery">
      {% for h in highlights %}
      <figure class="shot"><div class="shot__img"><img src="{{ root }}{{ h.img }}" alt="{{ h.alt | l(lang) }}" loading="lazy"></div><figcaption>{{ h.cap | l(lang) }}</figcaption></figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="students-h">
  <div class="wrap">
    <p class="eyebrow eyebrow--orange">{{ i18n.students.eyebrow | l(lang) }}</p>
    <h2 id="students-h">{{ i18n.students.title | l(lang) }}</h2>
    <div class="cards3">
      {% for it in i18n.students.items %}
      <div class="card">
        <span class="card__num">0{{ loop.index }}</span>
        <h3>{{ it.title | l(lang) }}</h3>
        <p>{{ it.desc | l(lang) }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt" id="research" aria-labelledby="research-h">
  <div class="wrap">
    <div class="sechead">
      <div><p class="eyebrow eyebrow--navy">{{ i18n.research.eyebrow | l(lang) }}</p><h2 id="research-h">{{ i18n.research.title | l(lang) }}</h2></div>
      <p class="sechead__lead">{{ i18n.research.lead | l(lang) }}</p>
    </div>
    <ol class="themes">
      {% for r in research %}
      <li class="theme" id="r-{{ r.id }}">
        <div class="theme__head"><span class="theme__num">0{{ loop.index }}</span><h3>{{ r.title | l(lang) }}</h3></div>
        <div class="theme__body"><p>{{ r.desc | l(lang) }}</p><p class="theme__tags">{{ r.tags }}</p></div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="industry" id="industry" aria-labelledby="industry-h">
  <div class="wrap">
    <div class="industry__head">
      <div><p class="eyebrow eyebrow--cyan">{{ i18n.industry.eyebrow | l(lang) }}</p><h2 id="industry-h">{{ i18n.industry.title | l(lang) }}</h2></div>
      <p class="industry__lead">{{ i18n.industry.lead | l(lang) }}</p>
    </div>
    <div class="svc-grid">
      {% for s in services %}
      <div class="svc">
        <h3>{{ s.title | l(lang) }}</h3>
        <p>{{ s.desc | l(lang) }}</p>
        <p class="svc__deliver">{{ s.deliver | l(lang) }}</p>
      </div>
      {% endfor %}
    </div>
    <h3 class="sectors__h">{{ i18n.industry.sectorsTitle | l(lang) }}</h3>
    <div class="sectors">
      {% for sc in i18n.industry.sectors %}
      <div class="sector"><span class="sector__n">{{ sc.name | l(lang) }}</span><span class="sector__d">{{ sc.need | l(lang) }}</span></div>
      {% endfor %}
    </div>
    <div class="industry__foot">
      <div class="chips"><span class="chips__label">{{ i18n.standards.label | l(lang) }}</span>{% for it in i18n.standards.items %}<span class="chip">{{ it | l(lang) }}</span>{% endfor %}</div>
      <a class="btn btn--cyan" href="mailto:{{ site.contact.email }}">{{ i18n.industry.cta | l(lang) }}</a>
    </div>
  </div>
</section>

<section class="section" id="cases" aria-labelledby="cases-h">
  <div class="wrap">
    <div class="sechead"><div><p class="eyebrow eyebrow--navy">{{ i18n.cases.eyebrow | l(lang) }}</p><h2 id="cases-h">{{ i18n.cases.title | l(lang) }}</h2></div><a class="more" href="{{ site.links.dept }}">{{ i18n.cases.all | l(lang) }} →</a></div>
    <div class="cases">
      {% for c in cases %}
      <article class="case">
        <span class="case__meta">{{ c.client | l(lang) }} · {{ c.years }}</span>
        <h3>{{ c.title | l(lang) }}</h3>
        <p>{{ c.desc | l(lang) }}</p>
        <span class="case__role">{{ c.role | l(lang) }}</span>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt" id="team" aria-labelledby="team-h">
  <div class="wrap">
    <p class="eyebrow eyebrow--navy">{{ i18n.team.eyebrow | l(lang) }}</p>
    <div class="pi">
      <div class="pi__photo" role="img" aria-label="{{ i18n.team.photo | l(lang) }}">{{ i18n.team.photo | l(lang) }}</div>
      <div class="pi__txt">
        <span class="pi__role">{{ i18n.team.pi | l(lang) }}</span>
        <h2 id="team-h">{{ site.pi.name | l(lang) }}</h2>
        <span class="pi__alt">{{ site.pi.nameAlt | l(lang) }}</span>
        <p>{{ site.pi.bio | l(lang) }}</p>
      </div>
    </div>
    <h3 class="sub-h">{{ i18n.team.members | l(lang) }}</h3>
    <ul class="members">
      {% for m in members %}
      <li class="member">
        <div class="member__photo" aria-hidden="true"></div>
        <span class="member__name">{{ m.name | l(lang) }}</span>
        <span class="member__role">{{ m.role | l(lang) }}</span>
        <span class="member__topic">{{ m.topic | l(lang) }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section" id="outputs">
  <div class="wrap two">
    <div>
      <h2>{{ i18n.outputs.title | l(lang) }}</h2>
      <ul class="pubs">
        {% for p in publications %}{% if p.selected %}
        <li class="pub">
          {% if p.doi %}<a class="pub__t" href="https://doi.org/{{ p.doi }}">{{ p.title }}</a>{% else %}<span class="pub__t">{{ p.title }}</span>{% endif %}
          <span class="pub__a">{{ p.authors }}</span>
          <span class="pub__v">{{ p.venue }} · {{ p.year }}</span>
        </li>
        {% endif %}{% endfor %}
      </ul>
      <a class="more" href="{{ site.links.dept }}">{{ i18n.outputs.all | l(lang) }} →</a>
    </div>
    <div id="news">
      <h2>{{ i18n.news.title | l(lang) }}</h2>
      <ul class="news">
        {% for n in news | take(3) %}
        <li class="news__i{% if n.placeholder %} news__i--ph{% endif %}"><span class="news__d">{{ n.date or '—' }}</span><span>{{ n.title | l(lang) }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section" id="join">
  <div class="wrap">
    <div class="joinbox">
      <div><h2>{{ i18n.join.title | l(lang) }}</h2><p>{{ i18n.join.lead | l(lang) }}</p></div>
      <div class="joinbox__act">
        <a class="btn btn--white" href="mailto:{{ site.contact.email }}">{{ i18n.join.email | l(lang) }}</a>
        <span class="joinbox__mail">{{ site.contact.email }}</span>
      </div>
    </div>
  </div>
</section>
